# --- App ---------------------------------------------------------------
# Publieke URL van de applicatie. Wordt gebruikt voor uitschrijflinks en als
# doel-URL voor de QStash-worker, dus moet van buitenaf bereikbaar zijn.
APP_URL=https://app.reviewmoment.nl

# Genereer met: openssl rand -hex 32
JWT_SECRET=
# Aparte sleutel voor uitschrijflinks. Valt terug op JWT_SECRET als die leeg is,
# maar gescheiden houden is beter: dan hoef je bij het roteren van sessies niet
# alle eerder verstuurde afmeldlinks ongeldig te maken.
UNSUBSCRIBE_SECRET=

# --- Database (Railway Postgres) -----------------------------------------------
# Via de pooler (poort 6543) voor de applicatie.
DATABASE_URL=postgresql://postgres.<ref>:<wachtwoord>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Directe verbinding (poort 5432) voor migraties.
DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<wachtwoord>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Resend ------------------------------------------------------------
RESEND_API_KEY=re_...
# Uit de webhook-instellingen in Resend (begint met whsec_)
RESEND_WEBHOOK_SECRET=whsec_...

# Hoofddomein waaronder elke klant een eigen verzend-subdomein krijgt.
# Bewust NIET het kale reviewmoment.nl: daar loopt je eigen zakelijke mail
# overheen, en die wil je niet laten meelijden als een klantlijst de reputatie
# verpest. Een klant krijgt dus kvik-maastricht.send.reviewmoment.nl.
SENDING_ROOT_DOMAIN=send.reviewmoment.nl
DMARC_REPORT_EMAIL=dmarc@reviewmoment.nl

# --- TransIP (DNS-provisioning) ----------------------------------------
# Je TransIP-gebruikersnaam en een sleutelpaar uit het controlepaneel onder
# "API". Zet de sleutel op "global key", anders bindt TransIP het token aan het
# IP dat het aanvroeg — en Railway heeft geen vast uitgaand IP.
TRANSIP_LOGIN=
TRANSIP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Alleen nodig bij een tweeledige extensie (.co.uk). Anders worden de laatste
# twee labels van SENDING_ROOT_DOMAIN gebruikt: send.reviewmoment.nl -> reviewmoment.nl
# TRANSIP_DOMAIN=reviewmoment.nl

# --- Railway Redis (rate limiting + quota) ------------------------------
REDIS_URL=redis://default:<wachtwoord>@redis.railway.internal:6379

# --- Upstash QStash (queue) ---------------------------------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
